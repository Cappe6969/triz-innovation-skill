#!/bin/sh
# Pre-commit gate: block the commit when the .agents/ mirror has drifted from
# the canonical .claude/skills/triz-innovation/ source.
#
# On failure, regenerate the mirror with `python scripts/build_mirror.py`,
# review the diff, then re-commit.

set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    # No Python available — never let a missing runtime block a commit.
    exit 0
fi

if "$PY" scripts/build_mirror.py --check >/dev/null 2>&1; then
    exit 0
fi

echo "MIRROR DRIFT: .agents/ is out of sync — run \`python scripts/build_mirror.py\` then re-commit" >&2
exit 1
